  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">meta</span></span></span><span> </span><span><span class="hljs-attr">charset</span></span><span>=</span><span><span class="hljs-string">"UTF-8"</span></span><span> /&gt;
  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">title</span></span></span><span>&gt;Anakin Skywalker | Home</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">title</span></span></span><span>&gt;
  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">link</span></span></span><span> </span><span><span class="hljs-attr">rel</span></span><span>=</span><span><span class="hljs-string">"stylesheet"</span></span><span> </span><span><span class="hljs-attr">href</span></span><span>=</span><span><span class="hljs-string">"style.css"</span></span><span> /&gt;
  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">link</span></span></span><span> </span><span><span class="hljs-attr">rel</span></span><span>=</span><span><span class="hljs-string">"icon"</span></span><span> </span><span><span class="hljs-attr">href</span></span><span>=</span><span><span class="hljs-string">"favicon.ico"</span></span><span> </span><span><span class="hljs-attr">type</span></span><span>=</span><span><span class="hljs-string">"image/x-icon"</span></span><span> /&gt;
</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">head</span></span></span><span>&gt;
</span><span><span class="hljs-tag">&lt;<span class="hljs-name">body</span></span></span><span>&gt;

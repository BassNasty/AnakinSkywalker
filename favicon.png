    </span><span><span class="hljs-tag">&lt;<span class="hljs-name">a</span></span></span><span> </span><span><span class="hljs-attr">href</span></span><span>=</span><span><span class="hljs-string">"darth-vader.html"</span></span><span>&gt;🔥 Darth Vader</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">a</span></span></span><span>&gt;
    </span><span><span class="hljs-tag">&lt;<span class="hljs-name">a</span></span></span><span> </span><span><span class="hljs-attr">href</span></span><span>=</span><span><span class="hljs-string">"legacy.html"</span></span><span>&gt;🌌 Legacy</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">a</span></span></span><span>&gt;
  </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;

  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">main</span></span></span><span>&gt;
    </span><span><span class="hljs-tag">&lt;<span class="hljs-name">p</span></span></span><span>&gt;As a Jedi Knight, Anakin fought bravely in the Clone Wars. His friendship with Obi-Wan Kenobi and his secret marriage to Padmé Amidala defined his turbulent years as a hero of the Republic.</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">p</span></span></span><span>&gt;
    </span><span><span class="hljs-tag">&lt;<span class="hljs-name">img</span></span></span><span> </span><span><span class="hljs-attr">src</span></span><span>=</span><span><span class="hljs-string">"https://upload.wikimedia.org/wikipedia/en/2/25/Anakin_Skywalker_Jedi_Knight.png"</span></span><span> </span><span><span class="hljs-attr">alt</span></span><span>=</span><span><span class="hljs-string">"Jedi Anakin"</span></span><span> /&gt;
    
    </span><span><span class="hljs-tag">&lt;<span class="hljs-name">h2</span></span></span><span>&gt;Famous Battles</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">h2</span></span></span><span>&gt;
    </span><span><span class="hljs-tag">&lt;<span class="hljs-name">ul</span></span></span><span>&gt;
      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">li</span></span></span><span>&gt;Battle of Geonosis</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">li</span></span></span><span>&gt;
      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">li</span></span></span><span>&gt;Battle of Christophsis</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">li</span></span></span><span>&gt;
      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">li</span></span></span><span>&gt;Battle of Coruscant</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">li</span></span></span><span>&gt;
    </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">ul</span></span></span><span>&gt;
  </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">main</span></span></span><span>&gt;
</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">body</span></span></span><span>&gt;
</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">html</span></span></span><span>&gt;
</span></span></code></div></div></pre>

057 5.53708 6.00551 6.00391 6.00391C6.00551 5.53708 6.01057 5.14051 6.03809 4.80371C6.0755 4.34588 6.15483 3.94012 6.34668 3.56348L6.46875 3.34473C6.77282 2.84912 7.20856 2.44514 7.72949 2.17969L7.87207 2.11328C8.20855 1.96886 8.56979 1.90385 8.9707 1.87109C9.42091 1.83432 9.978 1.83496 10.667 1.83496H13.5C14.1891 1.83496 14.746 1.83431 15.1963 1.87109C15.6541 1.90851 16.0599 1.98788 16.4365 2.17969L16.6553 2.30176C17.151 2.60585 17.5548 3.04244 17.8203 3.56348L17.8867 3.70606C18.031 4.04235 18.0962 4.40306 18.1289 4.80371C18.1657 5.25395 18.165 5.81091 18.165 6.5V9.33301Z"></path></svg>Copy code</button></div></div></div><div class="overflow-y-auto p-4" dir="ltr"><code class="whitespace-pre! language-css"><span><span><span class="hljs-comment">/* General page setup */</span></span><span>
</span><span><span class="hljs-selector-tag">body</span></span><span> {
  </span><span><span class="hljs-attribute">margin</span></span><span>: </span><span><span class="hljs-number">0</span></span><span>;
  </span><span><span class="hljs-attribute">font-family</span></span><span>: </span><span><span class="hljs-string">'Trebuchet MS'</span></span><span>, sans-serif;
  </span><span><span class="hljs-attribute">background</span></span><span>: </span><span><span class="hljs-built_in">linear-gradient</span></span><span>(to right, </span><span><span class="hljs-number">#000000</span></span><span>, </span><span><span class="hljs-number">#1a1a1a</span></span><span>);
  </span><span><span class="hljs-attribute">color</span></span><span>: </span><span><span class="hljs-number">#f5f5f5</span></span><span>;
  </span><span><span class="hljs-attribute">padding-left</span></span><span>: </span><span><span class="hljs-number">180px</span></span><span>;
  </span><span><span class="hljs-attribute">padding-top</span></span><span>: </span><span><span class="hljs-number">80px</span></span><span>;
}

</span><span><span class="hljs-comment">/* Header */</span></span><span>
</span><span><span class="hljs-selector-tag">header</span></span><span> {
  </span><span><span class="hljs-attribute">background-color</span></span><span>: </span><span><span class="hljs-number">#222</span></span><span>;
  </span><span><span class="hljs-attribute">color</span></span><span>: gold;
  </span><span><span class="hljs-attribute">position</span></span><span>: fixed;
  </span><span><span class="hljs-attribute">top</span></span><span>: </span><span><span class="hljs-number">0</span></span><span>;
  </span><span><span class="hljs-attribute">width</span></span><span>: </span><span><span class="hljs-number">100%</span></span><span>;
  </span><span><span class="hljs-attribute">height</span></span><span>: </span><span><span class="hljs-number">60px</span></span><span>;
  </span><span><span class="hljs-attribute">display</span></span><span>: flex;
  </span><span><span class="hljs-attribute">align-items</span></span><span>: center;
  </span><span><span class="hljs-attribute">justify-content</span></span><span>: center;
  </span><span><span class="hljs-attribute">z-index</span></span><span>: </span><span><span class="hljs-number">10</span></span><span>;
  </span><span><span class="hljs-attribute">box-shadow</span></span><span>: </span><span><span class="hljs-number">0</span></span><span> </span><span><span class="hljs-number">2px</span></span><span> </span><span><span class="hljs-number">5px</span></span><span> black;
}

</span><span><span class="hljs-comment">/* Sidebar */</span></span><span>
</span><span><span class="hljs-selector-class">.sidebar</span></span><span> {
  </span><span><span class="hljs-attribute">position</span></span><span>: fixed;
  </span><span><span class="hljs-attribute">top</span></span><span>: </span><span><span class="hljs-number">60px</span></span><span>;
  </span><span><span class="hljs-attribute">left</span></span><span>: </span><span><span class="hljs-number">0</span></span><span>;
  </span><span><span class="hljs-attribute">width</span></span><span>: </span><span><span class="hljs-number">160px</span></span><span>;
  </span><span><span class="hljs-attribute">height</span></span><span>: </span><span><span class="hljs-number">100%</span></span><span>;
  </span><span><span class="hljs-attribute">background-color</span></span><span>: </span><span><span class="hljs-number">#111</span></span><span>;
  </span><span><span class="hljs-attribute">display</span></span><span>: flex;
  </span><span><span class="hljs-attribute">flex-direction</span></span><span>: column;
  </span><span><span class="hljs-attribute">align-items</span></span><span>: center;
  </span><span><span class="hljs-attribute">padding-top</span></span><span>: </span><span><span class="hljs-number">20px</span></span><span>;
  </span><span><span class="hljs-attribute">z-index</span></span><span>: </span><span><span class="hljs-number">9</span></span><span>;
}

</span><span><span class="hljs-comment">/* Navigation links */</span></span><span>
</span><span><span class="hljs-selector-class">.sidebar</span></span><span> </span><span><span class="hljs-selector-tag">a</span></span><span> {
  </span><span><span class="hljs-attribute">color</span></span><span>: </span><span><span class="hljs-number">#f5f5f5</span></span><span>;
  </span><span><span class="hljs-attribute">text-decoration</span></span><span>: none;
  </span><span><span class="hljs-attribute">margin</span></span><span>: </span><span><span class="hljs-number">10px</span></span><span> </span><span><span class="hljs-number">0</span></span><span>;
  </span><span><span class="hljs-attribute">font-size</span></span><span>: </span><span><span class="hljs-number">16px</span></span><span>;
  </span><span><span class="hljs-attribute">display</span></span><span>: flex;
  </span><span><span class="hljs-attribute">align-items</span></span><span>: center;
  </span><span><span class="hljs-attribute">gap</span></span><span>: </span><span><span class="hljs-number">6px</span></span><span>;
}

</span><span><span class="hljs-selector-class">.sidebar</span></span><span> </span><span><span class="hljs-selector-tag">a</span></span><span><span class="hljs-selector-pseudo">:hover</span></span><span> {
  </span><span><span class="hljs-attribute">color</span></span><span>: gold;
}

</span><span><span class="hljs-comment">/* Headings and content */</span></span><span>
</span><span><span class="hljs-selector-tag">h1</span></span><span>, </span><span><span class="hljs-selector-tag">h2</span></span><span> {
  </span><span><span class="hljs-attribute">color</span></span><span>: gold;
  </span><span><span class="hljs-attribute">text-align</span></span><span>: center;
}

</span><span><span class="hljs-selector-tag">p</span></span><span> {
  </span><span><span class="hljs-attribute">text-align</span></span><span>: justify;
  </span><span><span class="hljs-attribute">line-height</span></span><span>: </span><span><span class="hljs-number">1.6</span></span><span>;
  </span><span><span class="hljs-attribute">margin</span></span><span>: </span><span><span class="hljs-number">20px</span></span><span>;
}

</span><span><span class="hljs-comment">/* Images */</span></span><span>
</span><span><span class="hljs-selector-tag">img</span></span><span> {
  </span><span><span class="hljs-attribute">display</span></span><span>: block;
  </span><span><span class="hljs-attribute">margin</span></span><span>: </span><span><span class="hljs-number">10px</span></span><span> auto;
  </span><span><span class="hljs-attribute">border-radius</span></span><span>: </span><span><span class="hljs-number">10px</span></span><span>;
  </span><span><span class="hljs-attribute">width</span></span><span>: </span><span><span class="hljs-number">60%</span></span><span>;
  </span><span><span class="hljs-attribute">box-shadow</span></span><span>: </span><span><span class="hljs-number">0</span></span><span> </span><span><span class="hljs-number">0</span></span><span> </span><span><span class="hljs-number">10px</span></span><span> black;
}

</span><span><span class="hljs-comment">/* Table */</span></span><span>
</span><span><span class="hljs-selector-tag">table</span></span><span> {
  </span><span><span class="hljs-attribute">margin</span></span><span>: </span><span><span class="hljs-number">20px</span></span><span> auto;
  </span><span><span class="hljs-attribute">border-collapse</span></span><span>: collapse;
  </span><span><span class="hljs-attribute">width</span></span><span>: </span><span><span class="hljs-number">70%</span></span><span>;
}

</span><span><span class="hljs-selector-tag">th</span></span><span>, </span><span><span class="hljs-selector-tag">td</span></span><span> {
  </span><span><span class="hljs-attribute">border</span></span><span>: </span><span><span class="hljs-number">1px</span></span><span> solid gold;
  </span><span><span class="hljs-attribute">padding</span></span><span>: </span><span><span class="hljs-number">10px</span></span><span>;
  </span><span><span class="hljs-attribute">text-align</span></span><span>: center;
}

</span><span><span class="hljs-selector-tag">th</span></span><span> {
  </span><span><span class="hljs-attribute">background-color</span></span><span>: </span><span><span class="hljs-number">#333</span></span><span>;
  </span><span><span class="hljs-attribute">color</span></span><span>: gold;
}

</span><span><span class="hljs-comment">/* Lists */</span></span><span>
</span><span><span class="hljs-selector-tag">ul</span></span><span> {
  </span><span><span class="hljs-attribute">margin</span></span><span>: </span><span><span class="hljs-number">20px</span></span><span>;
  </span><span><span class="hljs-attribute">list-style-type</span></span><span>: square;
}

</span><span><span class="hljs-comment">/* Video */</span></span><span>
</span><span><span class="hljs-selector-tag">video</span></span><span>, </span><span><span class="hljs-selector-tag">iframe</span></span><span> {
  </span><span><span class="hljs-attribute">display</span></span><span>: block;
  </span><span><span class="hljs-attribute">margin</span></span><span>: </span><span><span class="hljs-number">20px</span></span><span> auto;
  </span><span><span class="hljs-attribute">border</span></span><span>: </span><span><span class="hljs-number">2px</span></span><span> solid gold;
  </span><span><span class="hljs-attribute">border-radius</span></span><span>: </span><span><span class="hljs-number">10px</span></span><span>;
}

</span><span><span class="hljs-comment">/* Favicon */</span></span><span>
</span><span><span class="hljs-selector-pseudo">:root</span></span><span> {
  scroll-behavior: smooth;
}
</span></span></code></div></div></pre>
